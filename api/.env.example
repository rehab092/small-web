# Every value is optional; these are the defaults.
# MongoDB. Leave empty to use mongodb://127.0.0.1:27018/small-web, which is what
# `npm run dev:db` and `docker compose up -d` provide.
MONGO_URI=
# Port the API listens on.
PORT=4000
# Browser origin(s) allowed to call the API (comma separated).
CORS_ORIGIN=http://localhost:3000
